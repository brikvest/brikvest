modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.production]
SKIP_STARTUP_DATA_MAINTENANCE = "true"
APP_BASE_URL = "https://brikvest.net"
LEGAL_DISPATCH_PAUSED = "true"
FLW_ENABLED = "false"
FLW_LIVE_AUTHORIZED = "false"
FLW_NOTIFICATION_DISPATCH = "false"
FLW_WORKER_ENABLED = "false"

[userenv.development]
SKIP_POST_MERGE_DATABASE_MUTATIONS = "true"
SKIP_STARTUP_DATA_MAINTENANCE = "true"
LEGAL_DISPATCH_PAUSED = "true"
FLW_ENABLED = "false"
FLW_LIVE_AUTHORIZED = "false"
FLW_NOTIFICATION_DISPATCH = "false"
FLW_WORKER_ENABLED = "false"
BRIKVEST_TEST_PROVIDER_EMAILS_AUTHORIZED = "true"
BRIKVEST_TEST_RETURN_ORIGIN = "https://c9cabec7-4e6a-44ae-a612-5bcfc878158e-00-396cm9lmzx1ff-a62axqc9.kirk.replit.dev"
BRIKVEST_TEST_CALLBACK_APPROVED = "true"
BRIKVEST_TEST_CALLBACK_MODE = "private-browser-return"
BRIKVEST_TEST_PORT_REVIEW_WAIVED = "true"

[nix]
channel = "stable-25_05"
packages = ["libreoffice", "poppler-utils", "liberation_ttf", "dejavu_fonts", "chromium"]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173
